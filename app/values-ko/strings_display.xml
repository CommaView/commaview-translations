    <!-- The designs' names, notes and options in Display's picker (shared: the designs, through SharedWords). -->
    <string name="display_design_commaview_note">흐르는 경로, 앞차 잠금 표시, CommaView 고유의 속도, 상태, 알림. 가로 화면을 채우거나 카메라 전체를 보여 줍니다.</string>
    <string name="display_commaview_framing">카메라 구도</string>
    <string name="display_commaview_framing_detail">CommaView가 가로 화면을 쓰는 방식을 선택하세요.</string>
    <string name="display_commaview_full_camera">카메라 전체</string>
    <string name="display_commaview_full_camera_detail">카메라 영상 전체를 보여 주고, 필요하면 검은 여백을 둡니다.</string>
    <string name="display_commaview_fill_detail">카메라 영상을 잘라 가로 화면을 채웁니다. 세로 화면에서는 카메라 전체를 보여 줍니다.</string>
    <string name="display_pack_framing_detail">팩 화면이 가로 화면을 쓰는 방식을 선택하세요.</string>
